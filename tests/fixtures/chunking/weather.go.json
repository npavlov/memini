      "text": [
        "weather.go: Unit, Calm, Breeze, Gale, ErrNoReadings, Reading, Source, Station, Window",
        "// Package weather is a synthetic fixture for the chunker tests.",
        "package weather",
        "",
        "import (",
        "\t\"errors\"",
        "\t\"fmt\"",
        ")",
        "",
        "const Unit = \"celsius\"",
        "",
        "const (",
        "\tCalm = iota",
        "\tBreeze",
        "\tGale",
        ")",
        "",
        "var ErrNoReadings = errors.New(\"no readings\")",
        "",
        "// Reading is one measurement from a station.",
        "type Reading struct {",
        "\tStation string",
        "\tCelsius float64",
        "}",
        "",
        "type Source interface {",
        "\tReadings() ([]Reading, error)",
        "}",
        "",
        "type (",
        "\tStation string",
        "\tWindow  = []Reading",
        ")"
      ]
    },
    {
      "key": "Average#0",
      "id": "cb2c033ba65ac86acee8756499d8562718f102f4fa7b275b0238e39abc233531",
      "kind": "function",
      "symbol": "Average",
      "lines": [34, 44],
      "bytes": [429, 706],
      "content_hash": "52f2c29549229441e37c7a0c1be636f7751d09f6f890ca032bbf00750e0e8db2",
      "text": [
        "weather.go: Average",
        "// Average is the mean temperature of the readings.",
        "func Average(readings []Reading) (float64, error) {",
        "\tif len(readings) == 0 {",
        "\t\treturn 0, ErrNoReadings",
        "\t}",
        "\tsum := 0.0",
        "\tfor _, reading := range readings {",
        "\t\tsum += reading.Celsius",
        "\t}",
        "\treturn sum / float64(len(readings)), nil",
        "}"
      ]
    },
    {
      "key": "Reading.String#0",
      "id": "3fe6529c0ace2c786ef08c0fc8b1827f267480dc5d42a11c91696cc312b33d75",
      "kind": "group",
