      "text": [
        "tea_shop.rb: Counter, Counter.Pot, Counter.Pot.STEEP_MINUTES, Counter.Pot.initialize, Counter.Pot.small",
        "module Counter",
        "  # One pot of tea on the counter.",
        "  class Pot",
        "    include Comparable",
        "    attr_reader :leaves, :cups",
        "",
        "    STEEP_MINUTES = 4",
        "",
        "    def initialize(leaves, cups = 2)",
        "      @leaves = leaves",
        "      @cups = cups",
        "      @poured = 0",
        "    end",
        "",
        "    def self.small(leaves)",
        "      new(leaves, 1)",
        "    end"
      ]
    },
    {
      "key": "Counter.Pot.small#0+0",
