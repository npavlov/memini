      "content_hash": "d407ff52424914fc0f6564451580285309a09d2e76bc2608dc9d41137ddc582b",
      "text": [
        "tea_shop.rb: Counter.Pot.empty?, Counter.Pot.pour!, Counter.Pot.<=>, Counter.Pot.to_json, Counter.Pot.steeped?",
        "    def empty? = @poured >= @cups",
        "",
        "    def pour!",
        "      raise \"the pot is empty\" if empty?",
        "",
        "      @poured += 1",
        "      cups - @poured",
        "    end",
        "",
        "    def <=>(other)",
        "      cups <=> other.cups",
        "    end",
        "",
        "    def to_json(*args)",
        "      { leaves: leaves, cups: cups }.to_json(*args)",
        "    end",
        "",
        "    private",
        "",
        "    def steeped?(minutes)",
        "      minutes >= STEEP_MINUTES",
        "    end",
        "  end",
        "end"
      ]
    },
