      "text": [
        "tea_shop.rb: Counter.Pot.large, Counter.Pot.sizes",
        "    class << self",
        "      def large(leaves)",
        "        new(leaves, 6)",
        "      end",
        "",
        "      def sizes",
        "        [1, 2, 6]",
        "      end",
        "    end"
      ]
    },
    {
      "key": "Counter.Pot.empty?#0",
      "id": "846bcd0526ae199edd26f531d8ea1635a61230e2f02f23b91603ae39f2e683e5",
      "kind": "group",
      "symbol": "Counter.Pot",
      "lines": [36, 59],
