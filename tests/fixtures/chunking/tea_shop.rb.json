      "text": [
        "tea_shop.rb: Counter.Pot, open?",
        "class Counter::Pot",
        "  def refill",
        "    @poured = 0",
        "  end",
        "end",
        "",
        "def open?(hour)",
        "  hour >= OPENING_HOUR",
        "end",
        "",
        "puts Counter::Pot.small(\"mint\").pour! if $PROGRAM_NAME == __FILE__"
      ]
    }
