        "deploy.sh: TARGET_DIR, RETRIES, log",
        "#!/usr/bin/env bash",
        "# deploy.sh is a synthetic fixture for the chunker tests.",
        "set -euo pipefail",
        "",
        "TARGET_DIR=\"/srv/greenhouse\"",
        "RETRIES=3",
        "",
        "log() {",
        "  printf '%s %s\\n' \"$(date +%H:%M:%S)\" \"$*\"",
        "}"
      ]
