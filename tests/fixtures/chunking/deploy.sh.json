      "content_hash": "c72bcee32fcfe8327272618532098f92a99e925fafdd02df8923f38b0a39301a",
      "text": [
        "deploy.sh: copy_build",
        "# Copy the build to the target, retrying a few times.",
        "function copy_build {",
        "  local attempt=1",
        "  while (( attempt <= RETRIES )); do",
        "    if cp -r build/. \"$TARGET_DIR\"; then",
        "      return 0",
        "    fi",
        "    attempt=$((attempt + 1))",
        "  done",
        "  return 1",
        "}"
      ]
    },
    {
