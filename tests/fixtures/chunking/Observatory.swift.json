      "text": [
        "Observatory.swift: observe",
        "extension Telescope {",
        "    func catalogue() -> [String] {",
        "        return stars.map { $0.name }",
        "    }",
        "}",
        "",
        "func observe(_ telescope: Telescope) -> String {",
        "    return telescope.brightest()?.name ?? \"none\"",
        "}"
      ]
    }
