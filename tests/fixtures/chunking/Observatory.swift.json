      "text": [
        "Observatory.swift: Telescope",
        "final class Telescope: Lens {",
        "    private var stars: [Star] = []",
        "",
        "    init(stars: [Star]) {",
        "        self.stars = stars",
        "    }",
        "",
        "    /// The brightest star in view.",
        "    func brightest() -> Star? {",
        "        return stars.min { $0.magnitude < $1.magnitude }",
        "    }",
        "",
        "    func magnify(_ value: Double) -> Double {",
        "        return value * 40",
        "    }",
        "}"
      ]
    },
    {
      "key": "Telescope#0+0",
