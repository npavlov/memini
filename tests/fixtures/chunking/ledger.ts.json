      "content_hash": "6f1a2264ce99c2e9560af2457afdfd39389111fe4e63d4387f8829bc0014e856",
      "text": [
        "ledger.ts: Entry, Currency, Category, DEFAULT_CURRENCY, cents, total, sealed",
        "// Household ledger: a synthetic fixture for the chunker tests.",
        "import { readFile } from \"node:fs/promises\";",
        "",
        "export interface Entry {",
        "  date: string;",
        "  amount: number;",
        "  note?: string;",
        "}",
        "",
        "export type Currency = \"coins\" | \"shells\";",
        "",
        "export enum Category {",
        "  Food,",
        "  Garden,",
        "  Repairs,",
        "}",
        "",
        "const DEFAULT_CURRENCY: Currency = \"coins\";",
        "",
        "export const cents = (amount: number): number => Math.round(amount * 100);",
        "",
        "export function total(entries: Entry[]): number;",
        "export function total(entries: Entry[], category: Category): number;",
        "export function total(entries: Entry[], category?: Category): number {",
        "  return entries",
        "    .filter((entry) => category === undefined || entry.note === Category[category])",
        "    .reduce((sum, entry) => sum + entry.amount, 0);",
        "}",
        "",
        "function sealed(constructor: Function): void {",
        "  Object.seal(constructor);",
        "}"
      ]
    },
    {
      "key": "Ledger#0/+0",
      "id": "27108ec7b682b18e00d3db4719b2afa0e71d5b727662d1a7fab7df76b575692f",
      "kind": "group",
      "symbol": "Ledger",
      "lines": [34, 59],
      "bytes": [832, 1364],
      "content_hash": "f583abb123fb748d953dd930038510b4fc188dbab92961411398b2ff0b4b3059",
      "text": [
        "ledger.ts: Ledger, Ledger.onChange, Ledger.constructor, Ledger.add, Ledger.size",
        "/** A ledger kept in one currency. */",
        "@sealed",
        "export class Ledger {",
        "  private entries: Entry[] = [];",
        "  readonly currency: Currency;",
        "",
        "  onChange = (entry: Entry): void => {",
        "    console.log(entry.date);",
        "  };",
        "",
        "  constructor(currency: Currency = DEFAULT_CURRENCY) {",
        "    this.currency = currency;",
        "  }",
        "",
        "  add(entry: Entry): void {",
        "    this.entries.push(entry);",
        "    this.onChange(entry);",
        "  }",
        "",
        "  get size(): number {",
        "    return this.entries.length;",
        "  }",
        "",
        "  set size(value: number) {",
        "    throw new Error(`size is computed, not ${value}`);",
        "  }"
      ]
    },
    {
      "key": "Ledger.running#0",
      "id": "66fa562383a09d24d614d1527cfb9797fc452bd52e419718da3a589b0093144c",
      "kind": "method",
      "symbol": "Ledger.running",
      "lines": [61, 70],
      "bytes": [1366, 1623],
      "content_hash": "e3ae7b5f10590abbad917668633100aac84a0df6b8d9f53ed0ffa6cf1ee10793",
      "text": [
        "ledger.ts: Ledger.running",
        "  // Balance after every entry, oldest first.",
        "  running(): number[] {",
        "    const balances: number[] = [];",
        "    let balance = 0;",
        "    for (const entry of this.entries) {",
        "      balance += entry.amount;",
        "      balances.push(balance);",
        "    }",
        "    return balances;",
        "  }"
      ]
    },
    {
      "key": "Ledger.load#0",
      "id": "cf7e412eaeba476a189d061384377dee6d9e0d8f7a2bb28fd1094fa702a4568b",
      "kind": "method",
      "symbol": "Ledger.load",
      "lines": [72, 81],
      "bytes": [1625, 1929],
      "content_hash": "12d5f08499c93d181e2974dfde4b0e1790d0faaab1cd0dbb4a16e1fc709b7437",
      "text": [
        "ledger.ts: Ledger.load",
        "  static async load(path: string): Promise<Ledger> {",
        "    const ledger = new Ledger();",
        "    const text = await readFile(path, \"utf8\");",
        "    for (const line of text.split(\"\\n\")) {",
        "      const [date, amount] = line.split(\",\");",
        "      ledger.add({ date, amount: Number(amount) });",
        "    }",
        "    return ledger;",
        "  }",
        "}"
      ]
    },
    {
      "key": "Report#0",
      "id": "ad2d9e8d9d5d1622ddc22c1125d589ebeda822302e8719db2bcfe51d3c29d712",
      "kind": "group",
