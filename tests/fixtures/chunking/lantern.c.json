        "lantern.c: MAX_WICKS, BRIGHTNESS, Glow, Lantern",
        "/* lantern.c is a synthetic fixture for the chunker tests. */",
        "#include <stdio.h>",
        "",
        "#define MAX_WICKS 3",
        "#define BRIGHTNESS(w) ((w) * 40)",
        "",
        "typedef enum { DIM, STEADY, BRIGHT } Glow;",
        "",
        "struct Lantern {",
        "    int wicks;",
        "    Glow glow;",
        "};",
        "",
        "typedef struct Lantern Lantern;"
