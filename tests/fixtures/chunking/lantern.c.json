      "content_hash": "8158a258cd15b94567ee9940a575fcc8aee0d6c2ec5a543751d193c8f755cd3e",
      "text": [
        "lantern.c: clamp",
        "static int clamp(int value, int low, int high)",
        "{",
        "    if (value < low) {",
        "        return low;",
        "    }",
        "    return value > high ? high : value;",
        "}"
      ]
    },
