      "text": [
        "greenhouse.py: Tray.Label",
        "    class Label:",
        "        \"\"\"The label on the front of the tray.\"\"\"",
        "",
        "        def __init__(self, text: str) -> None:",
        "            self.text = text",
        "",
        "        def render(self) -> str:",
        "            return f\"[{self.text}]\"",
        "",
        "    # Trays are rotated every week so that every shelf gets the same light."
      ]
    },
    {
      "key": "rotate#0",
      "id": "e87f9882ebce99f11711d85c2899293f25d9e5763763175463a942ec6c011f29",
      "kind": "group",
      "symbol": null,
      "lines": [84, 91],
      "bytes": [1976, 2172],
      "content_hash": "80b86e8bfe353768a05d23038226a062da19448e48c71bbe92a635f381039e88",
      "text": [
        "greenhouse.py: rotate",
        "def rotate(trays: list[Tray]) -> list[Tray]:",
        "    if not trays:",
        "        return trays",
        "    return trays[1:] + trays[:1]",
        "",
        "",
        "def rotate(trays: list[Tray]) -> list[Tray]:",
        "    return list(reversed(trays))"
      ]
    },
    {
      "key": "schedule#0",
      "id": "5a27051eeb0c6b9b11e7ea77a68bf94a13fd275891c4c8b769b4b60dc095aafc",
      "kind": "function",
      "symbol": "schedule",
      "lines": [94, 105],
      "bytes": [2175, 2552],
      "content_hash": "24d3701b941d3754f8bf06e54fbaafed19bfab56d9c263e8385f06f996d5dad0",
      "text": [
        "greenhouse.py: schedule",
        "def schedule(trays: list[Tray], days: int) -> dict[int, float]:",
        "    \"\"\"Water for each day of a plan, in litres.\"\"\"",
        "",
        "    def daily(tray: Tray) -> float:",
        "        return tray.water_needed()",
        "",
        "    plan: dict[int, float] = {}",
        "    for day in range(days):",
        "        plan[day] = sum(daily(tray) for tray in trays)",
        "        if day % 7 == 6:",
        "            trays = rotate(trays)",
        "    return plan"
      ]
    },
