      "kind": "class",
      "symbol": "Seedling",
      "lines": [24, 32],
      "bytes": [351, 595],
      "content_hash": "eeea313668e7fdd9c19d0e0550da3a27ef574377ad194edfb0a002cb5842b899",
      "text": [
        "greenhouse.py: Seedling",
        "# Seedlings need water twice a day until they have four leaves.",
        "# After that, once a day is enough.",
        "@dataclass",
        "class Seedling:",
        "    name: str",
        "    leaves: int = 0",
        "",
        "    def waterings_per_day(self) -> int:",
        "        return 2 if self.leaves < 4 else 1"
      ]
    },
    {
      "key": "Tray#0/+0",
      "id": "ecb62307f09f9961bc71978d1fedf03dcc45efa99217fd752c3aff9d4eb2ec37",
      "kind": "group",
      "symbol": "Tray",
      "lines": [35, 62],
      "bytes": [598, 1410],
      "content_hash": "3e00fb2d3259ed0e69724812d47e2955dc0e5cefe860efdd83f9c4ea62c42b17",
      "text": [
        "greenhouse.py: Tray, Tray.__init__, Tray.plant, Tray.remove, Tray.full",
        "class Tray:",
        "    \"\"\"A tray of seedlings on one shelf.\"\"\"",
        "",
        "    capacity = 24",
        "",
        "    def __init__(self, shelf: int) -> None:",
        "        self.shelf = shelf",
        "        self.seedlings: list[Seedling] = []",
        "",
        "    def plant(self, seedling: Seedling) -> None:",
        "        if len(self.seedlings) >= self.capacity:",
        "            raise ValueError(\"the tray is full\")",
        "        self.seedlings.append(seedling)",
        "",
        "    def remove(self, name: str) -> Seedling | None:",
        "        for seedling in self.seedlings:",
        "            if seedling.name == name:",
        "                self.seedlings.remove(seedling)",
        "                return seedling",
        "        return None",
        "",
        "    @property",
        "    def full(self) -> bool:",
        "        return len(self.seedlings) >= self.capacity",
        "",
        "    @full.setter",
        "    def full(self, value: bool) -> None:",
        "        raise AttributeError(\"full is computed\")"
      ]
    },
    {
      "key": "Tray.water_needed#0",
      "id": "81a510295ed2d147872b55093925a96c8bda0122e0011ff9ab7fc0ab198839cf",
      "kind": "method",
      "symbol": "Tray.water_needed",
      "lines": [64, 70],
      "bytes": [1412, 1681],
      "content_hash": "42f9a2495ea200a4a702ced12c2f4c66ef30052877a3baf2e1539c20fe496198",
      "text": [
        "greenhouse.py: Tray.water_needed",
        "    def water_needed(self) -> float:",
        "        \"\"\"Litres of water the tray needs per day.\"\"\"",
        "        per_seedling = 150",
        "        total = 0",
        "        for seedling in self.seedlings:",
        "            total += per_seedling * seedling.waterings_per_day()",
        "        return litres(total)"
      ]
    },
    {
      "key": "Tray.Label#0",
      "id": "4fb467ea3911e0ac19d8ada4005ca1bcf1d3edc102187cbcb266c80fe4dadf57",
      "kind": "class",
