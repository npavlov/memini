        "mill.rs: Ledger, sacks, main",
        "type Ledger = HashMap<String, u32>;",
        "",
        "mod sacks {",
        "    pub fn weight(count: u32) -> u32 {",
        "        count * 25",
        "    }",
        "}",
        "",
        "fn main() {",
        "    let mut mill = Mill::new();",
        "    mill.grind(Grain::Rye, 100);",
        "    println!(\"{}\", mill.stock(Grain::Rye) + sacks::weight(1));",
        "}"
      ]
    }
