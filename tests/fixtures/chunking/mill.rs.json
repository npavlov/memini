      "text": [
        "mill.rs",
        "impl Grind for Mill {",
        "    fn grind(&mut self, grain: Grain, kilograms: u32) -> u32 {",
        "        let flour = kilograms * 9 / 10;",
        "        *self.flour.entry(grain).or_insert(0) += flour;",
        "        flour",
        "    }",
        "}"
      ]
    },
