      "text": [
        "mill.rs",
        "impl Mill {",
        "    pub fn new() -> Self {",
        "        Mill { flour: HashMap::new() }",
        "    }",
        "",
        "    /// Kilograms of flour of one grain.",
        "    pub fn stock(&self, grain: Grain) -> u32 {",
        "        *self.flour.get(&grain).unwrap_or(&0)",
        "    }",
        "}"
      ]
    },
    {
      "key": "Mill#0+1",
