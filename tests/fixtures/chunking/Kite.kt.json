      "text": [
        "Kite.kt: MAX_STRING_METRES, Flyer, Gust",
        "// Kite.kt is a synthetic fixture for the chunker tests.",
        "package town.kites",
        "",
        "import kotlin.math.max",
        "",
        "const val MAX_STRING_METRES = 60",
        "",
        "/** Anything that flies on a string. */",
        "interface Flyer {",
        "    fun lift(wind: Int): Int",
        "}",
        "",
        "enum class Gust { CALM, FRESH, STRONG }"
      ]
    },
    {
      "key": "Kite#0",
      "id": "2ccdb25e25baf30b437a1de00c8bbfce979ed8cbb4fb365d2ee2a3d4f33f549d",
      "kind": "class",
      "symbol": "Kite",
      "lines": [15, 25],
      "bytes": [266, 537],
      "content_hash": "6eaf23b1465b847cc6b5d8610c4ce6b47968e3d29605fb5835533e2c8825a707",
      "text": [
        "Kite.kt: Kite",
        "data class Kite(val colour: String, val tails: Int) : Flyer {",
        "    override fun lift(wind: Int): Int {",
        "        return max(0, wind - tails)",
        "    }",
        "",
        "    fun shorten(): Kite = copy(tails = tails - 1)",
        "",
        "    companion object {",
        "        fun plain(): Kite = Kite(\"white\", 0)",
        "    }",
        "}"
      ]
    },
    {
      "key": "Wind#0",
      "id": "0e78948a1a9627e7fdfed45407dc70b2e46a85c33ace12107130bac1911d20ff",
      "kind": "group",
