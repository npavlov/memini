      "text": [
        "Kite.kt: sky",
        "fun sky(kites: List<Kite>): Int {",
        "    var total = 0",
        "    for (kite in kites) {",
        "        total += kite.tails",
        "    }",
        "    return total",
        "}"
      ]
    }
