      "content_hash": "69667892dae1a9cb9e3f6e6e66094f784a1e93205085d569b307fee3d11dcb70",
      "text": [
        "Kite.kt: Wind, Kite.launch",
        "object Wind {",
        "    var speed = 3",
        "",
        "    fun gust(): Gust = if (speed > 10) Gust.STRONG else Gust.FRESH",
        "}",
        "",
        "fun Kite.launch(wind: Int): Boolean = lift(wind) > 2"
      ]
    },
    {
      "key": "sky#0",
