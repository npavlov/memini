        "garden.dart: Garden",
        "class Garden with Weeding implements Thirsty {",
        "  final List<String> beds;",
        "",
        "  Garden(this.beds);",
        "",
        "  /// Litres for one evening.",
        "  @override",
        "  int litres() {",
        "    return beds.length * 3;",
        "  }",
        "",
        "  String largest() => beds.reduce((a, b) => a.length >= b.length ? a : b);",
        "}"
