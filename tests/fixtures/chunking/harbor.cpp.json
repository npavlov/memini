      "text": [
        "harbor.cpp: port.deepest",
        "template <typename T>",
        "T deepest(const std::vector<T>& depths)",
        "{",
        "    T best = depths.front();",
        "    for (const T& depth : depths) {",
        "        if (depth > best) {",
        "            best = depth;",
        "        }",
        "    }",
        "    return best;",
        "}",
        "",
        "}  // namespace port"
      ]
    }
