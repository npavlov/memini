      "text": [
        "playlist.js: path, MAX_TRACKS, lastSeed, seconds, cycle",
        "\"use strict\";",
        "",
        "// Playlist shuffler: a synthetic fixture for the chunker tests.",
        "const path = require(\"node:path\");",
        "",
        "const MAX_TRACKS = 500;",
        "let lastSeed = 0;",
        "",
        "function seconds(minutes) {",
        "  return minutes * 60;",
        "}",
        "",
        "function* cycle(items) {",
        "  while (true) {",
        "    yield* items;",
        "  }",
        "}"
      ]
    },
    {
      "key": "Playlist#0",
      "id": "7a5483157fef3a6f6d81fca310f9aa14b8d2b6dc9dd377ca2ec2afd54dc6ebfd",
      "kind": "class",
      "symbol": "Playlist",
      "lines": [19, 59],
      "bytes": [280, 1108],
      "content_hash": "0618f00a1ba2d3e87793bdfb07f17153cb19cd6e3e7d1f098ae87d61934d29a4",
      "text": [
        "playlist.js: Playlist",
        "/**",
        " * A playlist of tracks; a track is { title, length }.",
        " */",
        "class Playlist {",
        "  #tracks = [];",
        "  static count = 0;",
        "",
        "  constructor(name) {",
        "    this.name = name;",
        "    Playlist.count += 1;",
        "  }",
        "",
        "  add(track) {",
        "    if (this.#tracks.length >= MAX_TRACKS) {",
        "      throw new Error(\"the playlist is full\");",
        "    }",
        "    this.#tracks.push(track);",
        "  }",
        "",
        "  get length() {",
        "    return this.#tracks.reduce((sum, track) => sum + track.length, 0);",
        "  }",
        "",
        "  shuffle(seed) {",
        "    lastSeed = seed;",
        "    const order = [...this.#tracks];",
        "    for (let i = order.length - 1; i > 0; i -= 1) {",
        "      const j = (seed * (i + 7)) % (i + 1);",
        "      [order[i], order[j]] = [order[j], order[i]];",
        "    }",
        "    return order;",
        "  }",
        "",
        "  #describe(track) {",
        "    return `${track.title} (${track.length}s)`;",
        "  }",
        "",
        "  onPlay = (track) => {",
        "    console.log(this.#describe(track));",
        "  };",
        "}"
      ]
    },
    {
