        "playlist.js: TrackList",
        "function TrackList({ tracks }) {",
        "  return (",
        "    <ul>",
        "      {tracks.map((track) => (",
        "        <li key={track.title}>{track.title}</li>",
        "      ))}",
        "    </ul>",
        "  );",
        "}"
      ]
    },
