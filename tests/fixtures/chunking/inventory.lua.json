        "inventory.lua: Inventory, MAX_ITEMS, clamp",
        "-- inventory.lua is a synthetic fixture for the chunker tests.",
        "local Inventory = {}",
        "Inventory.__index = Inventory",
        "",
        "local MAX_ITEMS = 40",
        "",
        "local function clamp(value, low, high)",
        "  if value < low then",
        "    return low",
        "  end",
        "  return math.min(value, high)",
        "end"
      ]
    },
