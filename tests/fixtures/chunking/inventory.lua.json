      "text": [
        "inventory.lua: Inventory.new",
        "-- A new, empty inventory.",
        "function Inventory.new(owner)",
        "  local self = setmetatable({}, Inventory)",
        "  self.owner = owner",
        "  self.items = {}",
        "  return self",
        "end"
      ]
    },
