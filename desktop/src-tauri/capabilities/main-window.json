{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the app's one window may ask of the Rust side: the app's own commands, and writing text to the clipboard. Nothing of Tauri's core, no shell, no file system, no network, no reading of the clipboard. The window shows local content only, so no remote origin is listed.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-connections-list",
    "allow-connection-save",
    "allow-connection-delete",
    "allow-connection-activate",
    "allow-connection-token-from-clipboard",
    "allow-connection-token-from-file",
    "allow-connection-token-clear",
    "allow-connection-check",
    "allow-api-status",
    "allow-api-workspaces",
    "allow-api-sources",
    "allow-api-catalog",
    "allow-api-domain",
    "allow-api-project",
    "allow-api-project-put",
    "allow-api-tools",
    "allow-api-tool-call",
    "allow-api-tokens-list",
    "allow-api-token-create",
    "allow-api-token-revoke",
    "allow-mcp-probe",
    "allow-clients-list",
    "allow-client-connect",
    "allow-client-disconnect",
    "allow-launcher-info",
    "allow-launcher-set-path",
    "allow-launcher-status",
    "allow-launcher-change",
    "allow-launcher-setup-token",
    "allow-launcher-uninstall",
    "allow-launcher-indexing",
    "allow-launcher-indexing-set",
    "allow-api-source-update",
    "allow-api-source-preview",
    "allow-api-run",
    "allow-launcher-repos",
    "allow-launcher-git",
    "allow-api-workspace-create",
    "allow-api-source-create",
    "allow-api-source-streams",
    "allow-api-source-sync",
    "allow-api-source-delete",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-secret"
  ]
}
