CLAUDE.local.md
.env
.env.memini
# Secret files of the compose stack (.env.example); secrets/unset is the empty file of a secret
# that is not set.
/secrets/*
!/secrets/unset
# Local additions to compose.yaml, such as the mount of local repositories (docs/install.md).
/compose.override.yaml
.venv/
__pycache__/
.DS_Store

# Backups (scripts/backup.sh): they hold private data
*.dump
*.dump.partial

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Python tooling
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Agent worktrees
.claude/worktrees/
